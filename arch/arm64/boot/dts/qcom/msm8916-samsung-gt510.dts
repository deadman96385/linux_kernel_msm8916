/dts-v1/;

#include "msm8916-samsung-gt5-common.dtsi"

/ {
	model = "Samsung Galaxy Tab A 9.7 (2015)";
	compatible = "samsung,gt510", "qcom,msm8916";
	chassis-type = "tablet";

	battery_sdi: battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion";
		charge-full-design-microamp-hours = <6111000>;
		voltage-max-design-microvolt = <4350000>;
		over-voltage-threshold-microvolt = <4400000>;
		re-charge-voltage-microvolt = <4250000>;
		constant-charge-current-max-microamp = <2200000>;
		constant-charge-voltage-max-microvolt = <4350000>;
		charge-term-current-microamp = <300000>;
		operating-range-celsius = <(-5) 60>;
		alert-celsius = <0 45>;
	};

	/* GT510 hardware revisions 3 and later use GPIO2/3. */
	i2c_max77849: i2c-max77849 {
		compatible = "i2c-gpio";
		sda-gpios = <&tlmm 2 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&tlmm 3 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <2>;

		pinctrl-0 = <&max77849_i2c_default>;
		pinctrl-names = "default";

		#address-cells = <1>;
		#size-cells = <0>;

		pmic@66 {
			compatible = "maxim,max77849";
			reg = <0x66>;
			interrupt-parent = <&tlmm>;
			interrupts = <12 IRQ_TYPE_EDGE_FALLING>;
			pinctrl-0 = <&max77849_int_default>;
			pinctrl-names = "default";
			wakeup-source;

			max77849_charger: charger {
				compatible = "maxim,max77849-charger";
				monitored-battery = <&battery_sdi>;
				maxim,monitored-fuel-gauge = <&fuelgauge>;

				/* Conservative USB profile until MUIC classifies VBUS. */
				maxim,input-current-limit-microamp = <460000>;
				maxim,input-current-limit-max-microamp = <1800000>;
				maxim,charge-current-limit-microamp = <520000>;
				maxim,cdp-input-current-limit-microamp = <1000000>;
				maxim,cdp-charge-current-limit-microamp = <1000000>;
				maxim,dcp-input-current-limit-microamp = <1800000>;
				maxim,dcp-charge-current-limit-microamp = <2200000>;
				maxim,otg-current-limit-microamp = <500000>;
				maxim,min-system-microvolt = <3600000>;
				maxim,fast-charge-timer-hours = <16>;
				maxim,topoff-timer-minutes = <70>;
				maxim,poll-interval-ms = <5000>;
			};

			muic: extcon {
				compatible = "maxim,max77849-muic";
				maxim,charger = <&max77849_charger>;
				maxim,poll-interval-ms = <1000>;

				connector {
					compatible = "usb-b-connector";
					label = "micro-USB";
					type = "micro";
				};
			};
		};
	};

	i2c_backlight: i2c-backlight {
		compatible = "i2c-gpio";
		sda-gpios = <&tlmm 24 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&tlmm 25 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <4>;

		pinctrl-0 = <&backlight_i2c_default>;
		pinctrl-names = "default";

		#address-cells = <1>;
		#size-cells = <0>;

		backlight: backlight@2c {
			compatible = "ti,lp8558";
			reg = <0x2c>;
			bl-name = "lcd-backlight";
			dev-ctrl = /bits/ 8 <0x83>;
			init-brt = /bits/ 8 <0xcd>;
			power-supply = <&reg_lcd_vmipi>;
			enable-supply = <&reg_backlight_enable>;

			rom-a5h {
				rom-addr = /bits/ 8 <0xa5>;
				rom-val = /bits/ 8 <0x14>;
			};

			rom-a3h {
				rom-addr = /bits/ 8 <0xa3>;
				rom-val = /bits/ 8 <0x5e>;
			};

			rom-a0h {
				rom-addr = /bits/ 8 <0xa0>;
				rom-val = /bits/ 8 <0x65>;
			};

			rom-a1h {
				rom-addr = /bits/ 8 <0xa1>;
				rom-val = /bits/ 8 <0x6e>;
			};

			rom-a6h {
				rom-addr = /bits/ 8 <0xa6>;
				rom-val = /bits/ 8 <0x40>;
			};

			rom-a9h {
				rom-addr = /bits/ 8 <0xa9>;
				rom-val = /bits/ 8 <0xa0>;
			};

			rom-98h {
				rom-addr = /bits/ 8 <0x98>;
				rom-val = /bits/ 8 <0x21>;
			};

			rom-9eh {
				rom-addr = /bits/ 8 <0x9e>;
				rom-val = /bits/ 8 <0x00>;
			};
		};
	};

	speaker_codec: audio-codec {
		compatible = "maxim,max98357a";
		sdmode-gpios = <&tlmm 55 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		pinctrl-0 = <&audio_sdmode_default>;
		pinctrl-names = "default";
	};

	clk_pwm: pwm {
		compatible = "clk-pwm";
		#pwm-cells = <2>;

		clocks = <&gcc GCC_GP2_CLK>;

		pinctrl-0 = <&motor_pwm_default>;
		pinctrl-names = "default";
	};

	reg_lcd_vmipi: regulator-lcd-vmipi {
		compatible = "regulator-fixed";
		regulator-name = "lcd_vmipi";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;

		gpio = <&tlmm 8 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&lcd_en_default>;
		pinctrl-names = "default";
	};

	reg_backlight_enable: regulator-backlight-enable {
		compatible = "regulator-fixed";
		regulator-name = "backlight_enable";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;

		gpio = <&tlmm 69 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&backlight_enable_default>;
		pinctrl-names = "default";
	};

	reg_camera_vana: regulator-camera-vana {
		compatible = "regulator-fixed";
		regulator-name = "camera_vana";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;

		gpio = <&tlmm 16 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&camera_vana_default>;
		pinctrl-names = "default";
	};

	reg_camera_vdig: regulator-camera-vdig {
		compatible = "regulator-fixed";
		regulator-name = "camera_vdig";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;

		gpio = <&tlmm 33 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&camera_vdig_default>;
		pinctrl-names = "default";
	};

	/* Revisions through r06 switch VIO here; the line is unused on r07. */
	reg_camera_vio: regulator-camera-vio {
		compatible = "regulator-fixed";
		regulator-name = "camera_vio";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;

		gpio = <&tlmm 120 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&camera_vio_default>;
		pinctrl-names = "default";
	};

	reg_motor_vdd: regulator-motor-vdd {
		compatible = "regulator-fixed";
		regulator-name = "motor_vdd";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;

		gpio = <&tlmm 76 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&motor_en_default>;
		pinctrl-names = "default";
	};

	reg_tsp_1p8v: regulator-tsp-1p8v {
		compatible = "regulator-fixed";
		regulator-name = "tsp_1p8v";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;

		gpio = <&tlmm 73 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&tsp_en_default>;
		pinctrl-names = "default";
	};

	reg_tsp_3p3v: regulator-tsp-3p3v {
		compatible = "regulator-fixed";
		regulator-name = "tsp_3p3v";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		gpio = <&tlmm 73 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	reg_vlcd_5p4v: regulator-vlcd-5p4v {
		compatible = "regulator-fixed";
		regulator-name = "vlcd_5p4v";
		regulator-min-microvolt = <5400000>;
		regulator-max-microvolt = <5400000>;

		gpio = <&tlmm 51 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&buckbooster_en_default>;
		pinctrl-names = "default";
	};

	vibrator {
		compatible = "pwm-vibrator";

		pwms = <&clk_pwm 0 100000>;
		pwm-names = "enable";

		vcc-supply = <&reg_motor_vdd>;
	};
};

&blsp_i2c5 {
	status = "okay";

	touchscreen@4a {
		compatible = "atmel,maxtouch";
		reg = <0x4a>;
		interrupt-parent = <&tlmm>;
		interrupts = <13 IRQ_TYPE_LEVEL_LOW>;

		vdd-supply = <&reg_tsp_1p8v>;
		vdda-supply = <&reg_tsp_3p3v>;

		reset-gpios = <&tlmm 114 GPIO_ACTIVE_LOW>;

		pinctrl-0 = <&tsp_int_rst_default>;
		pinctrl-names = "default";

		linux,keycodes = <KEY_APPSELECT KEY_BACK>;
	};
};

&camss {
	status = "okay";

	ports {
		port@0 {
			reg = <0>;

			csiphy0_ep: endpoint {
				clock-noncontinuous;
				data-lanes = <0 2>;
				remote-endpoint = <&sr544_ep>;
			};
		};

		port@1 {
			reg = <1>;

			csiphy1_ep: endpoint {
				clock-noncontinuous;
				data-lanes = <0>;
				remote-endpoint = <&sr200pc20_ep>;
			};
		};
	};
};

&cci {
	status = "okay";
};

&cci_i2c0 {
	camera@28 {
		compatible = "siliconfile,sr544";
		reg = <0x28>;

		clocks = <&gcc GCC_CAMSS_MCLK0_CLK>;
		clock-names = "xclk";
		assigned-clocks = <&gcc GCC_CAMSS_MCLK0_CLK>;
		assigned-clock-rates = <26000000>;

		pinctrl-0 = <&gt510_camera_rear_default>;
		pinctrl-names = "default";

		reset-gpios = <&tlmm 35 GPIO_ACTIVE_HIGH>;
		standby-gpios = <&tlmm 34 GPIO_ACTIVE_HIGH>;

		vana-supply = <&reg_camera_vana>;
		vdig-supply = <&reg_camera_vdig>;
		vio-supply = <&reg_camera_vio>;
		lens-focus = <&dw9804>;

		rotation = <90>;

		port {
			sr544_ep: endpoint {
				clock-noncontinuous;
				data-lanes = <1 2>;
				link-frequencies = /bits/ 64 <440000000>;
				remote-endpoint = <&csiphy0_ep>;
			};
		};
	};

	dw9804: camera-lens@c {
		compatible = "dongwoon,dw9804";
		reg = <0x0c>;
		iovdd-supply = <&reg_camera_vdig>;
		vcc-supply = <&pm8916_l10>;
	};

	camera@20 {
		compatible = "siliconfile,sr200pc20";
		reg = <0x20>;

		clocks = <&gcc GCC_CAMSS_MCLK1_CLK>;
		clock-names = "xclk";
		assigned-clocks = <&gcc GCC_CAMSS_MCLK1_CLK>;
		assigned-clock-rates = <26000000>;

		pinctrl-0 = <&gt510_camera_front_default>;
		pinctrl-names = "default";

		reset-gpios = <&tlmm 28 GPIO_ACTIVE_HIGH>;
		standby-gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;

		vana-supply = <&reg_camera_vana>;
		vdig-supply = <&reg_camera_vdig>;
		vio-supply = <&reg_camera_vio>;

		rotation = <270>;

		port {
			sr200pc20_ep: endpoint {
				clock-noncontinuous;
				data-lanes = <1>;
				link-frequencies = /bits/ 64 <144000000>;
				remote-endpoint = <&csiphy1_ep>;
			};
		};
	};
};

&gpu {
	status = "okay";
};

&fuelgauge {
	power-supplies = <&max77849_charger>;
};

&usb {
	dr_mode = "otg";
	extcon = <&muic>, <&muic>;
};

&usb_hs_phy {
	extcon = <&muic>;
};

&mdss {
	status = "okay";
};

&mdss_dsi0 {
	pinctrl-0 = <&mdss_default>;
	pinctrl-1 = <&mdss_sleep>;
	pinctrl-names = "default", "sleep";

	panel@0 {
		compatible = "samsung,ltl101at01", "samsung,s6d7aa0";
		reg = <0>;

		power-supply = <&reg_vlcd_5p4v>;
		vmipi-supply = <&reg_lcd_vmipi>;
		reset-gpios = <&tlmm 97 GPIO_ACTIVE_LOW>;
		backlight = <&backlight>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	data-lanes = <0 1 2 3>;
	remote-endpoint = <&panel_in>;
};

&sound {
	model = "samsung-gt510";
	pinctrl-0 = <&cdc_pdm_default &sec_mi2s_default>;
	pinctrl-1 = <&cdc_pdm_sleep &sec_mi2s_sleep>;
	pinctrl-names = "default", "sleep";
};

&tlmm {
	backlight_enable_default: backlight-enable-default-state {
		pins = "gpio69";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	backlight_i2c_default: backlight-i2c-default-state {
		pins = "gpio24", "gpio25";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	gt510_camera_front_default: gt510-camera-front-default-state {
		control-pins {
			pins = "gpio28", "gpio32";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};

		mclk-pins {
			pins = "gpio27";
			function = "cam_mclk1";
			drive-strength = <4>;
			bias-disable;
		};
	};

	gt510_camera_rear_default: gt510-camera-rear-default-state {
		control-pins {
			pins = "gpio34", "gpio35";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};

		mclk-pins {
			pins = "gpio26";
			function = "cam_mclk0";
			drive-strength = <4>;
			bias-disable;
		};
	};

	camera_vana_default: camera-vana-default-state {
		pins = "gpio16";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	camera_vdig_default: camera-vdig-default-state {
		pins = "gpio33";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	camera_vio_default: camera-vio-default-state {
		pins = "gpio120";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	audio_sdmode_default: audio-sdmode-default-state {
		pins = "gpio55";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	buckbooster_en_default: buckbooster-en-default-state {
		pins = "gpio51";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	motor_en_default: motor-en-default-state {
		pins = "gpio76";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	motor_pwm_default: motor-pwm-default-state {
		pins = "gpio50";
		function = "gcc_gp2_clk_a";
	};

	lcd_en_default: lcd-en-default-state {
		pins = "gpio8";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	max77849_i2c_default: max77849-i2c-default-state {
		pins = "gpio2", "gpio3";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	max77849_int_default: max77849-int-default-state {
		pins = "gpio12";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	mdss_default: mdss-default-state {
		pins = "gpio97";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	mdss_sleep: mdss-sleep-state {
		pins = "gpio97";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	tsp_en_default: tsp-en-default-state {
		pins = "gpio73";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	tsp_int_rst_default: tsp-int-rst-default-state {
		pins = "gpio13", "gpio114";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};
