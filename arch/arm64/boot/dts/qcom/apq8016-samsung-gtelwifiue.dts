/dts-v1/;

#include "msm8916-pm8916.dtsi"
#include <dt-bindings/sound/apq8016-lpass.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "Samsung Galaxy Tab E 9.6 (SM-T560NU)";
	compatible = "samsung,gtelwifiue", "qcom,apq8016";
	chassis-type = "tablet";

	aliases {
		mmc0 = &sdhc_1; /* eMMC */
		mmc1 = &sdhc_2; /* SD card */
		serial0 = &blsp_uart2;
	};

	chosen {
		stdout-path = "serial0";
	};

	battery: battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion";
		charge-full-design-microamp-hours = <5000000>;
		voltage-min-design-microvolt = <3400000>;
		voltage-max-design-microvolt = <4350000>;
		constant-charge-current-max-microamp = <1500000>;
		constant-charge-voltage-max-microvolt = <4350000>;
		charge-term-current-microamp = <275000>;
		operating-range-celsius = <(-5) 60>;
		alert-celsius = <0 45>;
	};

	reserved-memory {
		/* Additional memory used by Samsung firmware modifications */
		tz-apps@85500000 {
			reg = <0x0 0x85500000 0x0 0xb00000>;
			no-map;
		};
	};

	i2c-backlight {
		compatible = "i2c-gpio";
		sda-gpios = <&tlmm 24 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&tlmm 25 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;

		pinctrl-0 = <&backlight_i2c_default>;
		pinctrl-names = "default";

		#address-cells = <1>;
		#size-cells = <0>;

		backlight: backlight@31 {
			compatible = "richtek,rt8555";
			reg = <0x31>;

			enable-gpios = <&tlmm 69 GPIO_ACTIVE_HIGH>;
			pinctrl-0 = <&backlight_enable_default>;
			pinctrl-names = "default";

			max-brightness = <255>;
			default-brightness = <120>;
			richtek,led-current-microamp = <25000>;
			richtek,led-driver-headroom-microvolt = <570000>;
			richtek,device-config = /bits/ 8 <0x05 0x08>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		pinctrl-0 = <&gpio_keys_default>;
		pinctrl-names = "default";

		label = "GPIO Buttons";

		volume-up-button {
			label = "Volume Up";
			gpios = <&tlmm 107 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
		};

		home-button {
			label = "Home";
			gpios = <&tlmm 109 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_HOMEPAGE>;
		};
	};

	reg_vdd_tsp: regulator-vdd-tsp {
		compatible = "regulator-fixed";
		regulator-name = "vdd_tsp";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		gpio = <&tlmm 73 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&reg_tsp_en_default>;
		pinctrl-names = "default";

		startup-delay-us = <150>;
	};

	reg_lcd_vdd: regulator-lcd-vdd {
		compatible = "regulator-fixed";
		regulator-name = "lcd-vdd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		gpio = <&tlmm 8 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&lcd_vdd_en_default>;
		pinctrl-names = "default";
	};

	reg_lcd_vsp: regulator-lcd-vsp {
		compatible = "regulator-fixed";
		regulator-name = "lcd-vsp";

		gpio = <&tlmm 20 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&lcd_vsp_en_default>;
		pinctrl-names = "default";
	};

	reg_lcd_vsn: regulator-lcd-vsn {
		compatible = "regulator-fixed";
		regulator-name = "lcd-vsn";

		gpio = <&tlmm 120 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&lcd_vsn_en_default>;
		pinctrl-names = "default";
	};
};

&blsp_i2c1 {
	status = "okay";

	muic: extcon@25 {
		compatible = "siliconmitus,sm5703-muic";
		reg = <0x25>;

		interrupt-parent = <&tlmm>;
		interrupts = <12 IRQ_TYPE_EDGE_FALLING>;
		wakeup-source;

		pinctrl-0 = <&muic_int_default>;
		pinctrl-names = "default";

		usb_con: connector {
			compatible = "usb-b-connector";
			label = "micro-USB";
			type = "micro";
		};
	};
};

&blsp_i2c2 {
	status = "okay";

	accelerometer@1d {
		compatible = "st,lis2hh12";
		reg = <0x1d>;

		vdd-supply = <&pm8916_l17>;
		vddio-supply = <&pm8916_l5>;

		interrupt-parent = <&tlmm>;
		interrupts = <115 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "INT1";

		st,drdy-int-pin = <1>;
		mount-matrix = "0", "1", "0",
				  "-1", "0", "0",
				   "0", "0", "1";

		pinctrl-0 = <&accel_int_default>;
		pinctrl-names = "default";
	};
};

&blsp_i2c3 {
	status = "okay";

	sm5703: pmic@49 {
		compatible = "siliconmitus,sm5703";
		reg = <0x49>;

		interrupt-parent = <&tlmm>;
		interrupts = <1 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&tlmm 36 GPIO_ACTIVE_LOW>;

		pinctrl-0 = <&sm5703_default>;
		pinctrl-names = "default";
		wakeup-source;

		regulators {
			sm5703_buck: buck {
				regulator-name = "cam_sensor_core_1p2";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
			};

			sm5703_ldo1: ldo1 {
				regulator-name = "cam_sensor_a2p8";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
			};

			sm5703_ldo2: ldo2 {
				regulator-name = "cam_vio";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			sm5703_ldo3: ldo3 {
				regulator-name = "vdd_motor";
				regulator-min-microvolt = <1500000>;
				regulator-max-microvolt = <3300000>;
			};

			sm5703_usbldo1: usbldo1 {
				regulator-name = "usbldo1";
				regulator-min-microvolt = <4800000>;
				regulator-max-microvolt = <4800000>;
				regulator-always-on;
			};

			sm5703_usbldo2: usbldo2 {
				regulator-name = "usbldo2";
				regulator-min-microvolt = <4800000>;
				regulator-max-microvolt = <4800000>;
			};

			sm5703_vbus: vbus {
				regulator-name = "usb_vbus";
				regulator-min-microvolt = <5000000>;
				regulator-max-microvolt = <5000000>;
				regulator-max-microamp = <1200000>;
			};
		};

		charger: charger {
			compatible = "siliconmitus,sm5703-charger";
			monitored-battery = <&battery>;
			siliconmitus,monitored-fuel-gauge = <&fuel_gauge>;
			siliconmitus,usb-connector = <&usb_con>;
			enable-gpios = <&tlmm 119 GPIO_ACTIVE_LOW>;
			input-current-limit-microamp = <1000000>;
			input-voltage-limit-microvolt = <4300000>;
			siliconmitus,topoff-timer-minutes = <45>;
			siliconmitus,boost-iq3-limit-1x;
		};
	};
};

&blsp_i2c4 {
	status = "okay";

	fuel_gauge: fuel-gauge@71 {
		compatible = "siliconmitus,sm5703-fuel-gauge";
		reg = <0x71>;

		interrupt-parent = <&tlmm>;
		interrupts = <121 IRQ_TYPE_EDGE_FALLING>;
		pinctrl-0 = <&fuel_gauge_int_default>;
		pinctrl-names = "default";
		wakeup-source;

		monitored-battery = <&battery>;
		power-supplies = <&charger>;

		siliconmitus,battery-table-0 =
			<0x1400 0x1b99 0x1bfd 0x1cb5 0x1d65 0x1d9c 0x1dee 0x1e72
			 0x1ee4 0x1f4d 0x1ff9 0x2077 0x2099 0x220a 0x2270 0x2399>;
		siliconmitus,battery-table-1 =
			<0x1400 0x1b99 0x1bfd 0x1cb5 0x1d65 0x1d9c 0x1dee 0x1e72
			 0x1ee4 0x1f4d 0x1ff9 0x2077 0x2099 0x220a 0x2270 0x2399>;
		siliconmitus,battery-table-2 =
			<0x0000 0x0095 0x00e0 0x01b1 0x0327 0x076a 0x0bbd 0x18a5
			 0x1fc5 0x22a1 0x29d0 0x2cad 0x2e13 0x381f 0x3a66 0x3a93>;
		siliconmitus,rce-values = <0x0749 0x0580 0x0371>;
		siliconmitus,dtcd-value = <1>;
		siliconmitus,rs-values = <0x01ae 0x047a 0x3800 0x00a4>;
		siliconmitus,vit-period = <0x350a>;
		siliconmitus,mix-values = <0x0503 0x0004>;
		siliconmitus,topoff-soc-values = <0 0x0101>;
		siliconmitus,voltage-calibration = <0x8000>;
		siliconmitus,current-calibration = <0x7085>;
		siliconmitus,temperature-standard-celsius = <25>;
		siliconmitus,temperature-offset-divisor = <10>;
		siliconmitus,temperature-offset-calibration = <1>;
		siliconmitus,charge-offset-calibration = <12>;
		siliconmitus,fuel-alert-soc = <1>;
		siliconmitus,voltage-alert-microvolt = <3125000>;
	};
};

&blsp_i2c5 {
	status = "okay";

	touchscreen@20 {
		compatible = "zinitix,zt7554";
		reg = <0x20>;
		interrupt-parent = <&tlmm>;
		interrupts = <13 IRQ_TYPE_EDGE_FALLING>;

		touchscreen-size-x = <800>;
		touchscreen-size-y = <1280>;
		linux,keycodes = <KEY_APPSELECT KEY_BACK>;
		extcon = <&muic>;

		vcca-supply = <&reg_vdd_tsp>;
		vdd-supply = <&pm8916_l5>;

		pinctrl-0 = <&tsp_int_default>;
		pinctrl-names = "default";
	};
};

&blsp_uart2 {
	status = "okay";
};

&gpu {
	status = "okay";
};

&lpass {
	status = "okay";
};

&lpass_codec {
	status = "okay";
};

&mdss {
	status = "okay";
};

&mdss_dsi0 {
	panel@0 {
		compatible = "boe,tv096wxm-nh0";
		reg = <0>;

		backlight = <&backlight>;
		vdd-supply = <&reg_lcd_vdd>;
		vsp-supply = <&reg_lcd_vsp>;
		vsn-supply = <&reg_lcd_vsn>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	data-lanes = <0 1 2 3>;
	remote-endpoint = <&panel_in>;
};

&pm8916_codec {
	jack-gpios = <&tlmm 110 GPIO_ACTIVE_LOW>;
	qcom,micbias-lvl = <2800>;

	qcom,mbhc-vthreshold-low = <75 150 237 450 500>;
	qcom,mbhc-vthreshold-high = <75 150 237 450 500>;

	pinctrl-0 = <&jack_default>;
	pinctrl-names = "default";

	status = "okay";
};

&pm8916_resin {
	linux,code = <KEY_VOLUMEDOWN>;
	status = "okay";
};

&pm8916_rpm_regulators {
	pm8916_l17: l17 {
		regulator-min-microvolt = <2850000>;
		regulator-max-microvolt = <2850000>;
	};
};

&sdhc_1 {
	status = "okay";
};

&sdhc_2 {
	pinctrl-0 = <&sdc2_default &sdc2_cd_default>;
	pinctrl-1 = <&sdc2_sleep &sdc2_cd_default>;
	pinctrl-names = "default", "sleep";

	cd-gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;

	status = "okay";
};

&sound {
	pinctrl-0 = <&cdc_pdm_default>;
	pinctrl-1 = <&cdc_pdm_sleep>;
	pinctrl-names = "default", "sleep";

	model = "msm8916";
	audio-routing =
		"AMIC1", "MIC BIAS Internal1",
		"AMIC2", "MIC BIAS Internal2";

	status = "okay";

	dai-link-primary {
		link-name = "Primary MI2S";

		cpu {
			sound-dai = <&lpass MI2S_PRIMARY>;
		};

		codec {
			sound-dai = <&lpass_codec 0>, <&pm8916_codec 0>;
		};
	};

	dai-link-tertiary {
		link-name = "Tertiary MI2S";

		cpu {
			sound-dai = <&lpass MI2S_TERTIARY>;
		};

		codec {
			sound-dai = <&lpass_codec 1>, <&pm8916_codec 1>;
		};
	};
};

&usb {
	extcon = <&muic>, <&muic>;
	vbus-supply = <&sm5703_vbus>;
	status = "okay";
};

&usb_hs_phy {
	extcon = <&muic>;
};

&venus {
	status = "okay";
};

&venus_mem {
	status = "okay";
};

&wcnss {
	status = "okay";
};

&wcnss_iris {
	compatible = "qcom,wcn3660b";
};

&wcnss_mem {
	status = "okay";
};

&tlmm {
	accel_int_default: accel-int-default-state {
		pins = "gpio115";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	backlight_enable_default: backlight-enable-default-state {
		pins = "gpio69";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	backlight_i2c_default: backlight-i2c-default-state {
		pins = "gpio24", "gpio25";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	jack_default: jack-default-state {
		pins = "gpio110";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	gpio_keys_default: gpio-keys-default-state {
		pins = "gpio107", "gpio109";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	muic_int_default: muic-int-default-state {
		pins = "gpio12";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	fuel_gauge_int_default: fuel-gauge-int-default-state {
		pins = "gpio121";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	lcd_vdd_en_default: lcd-vdd-en-default-state {
		pins = "gpio8";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	lcd_vsp_en_default: lcd-vsp-en-default-state {
		pins = "gpio20";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	lcd_vsn_en_default: lcd-vsn-en-default-state {
		pins = "gpio120";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	reg_tsp_en_default: reg-tsp-en-default-state {
		pins = "gpio73";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	sm5703_default: sm5703-default-state {
		pins = "gpio1", "gpio36", "gpio119";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	sdc2_cd_default: sdc2-cd-default-state {
		pins = "gpio38";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	tsp_int_default: tsp-int-default-state {
		pins = "gpio13";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};
